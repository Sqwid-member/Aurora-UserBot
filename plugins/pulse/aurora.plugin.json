{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Монітор живості: щотикує, рахує апдейти й показує стан плагінів у панелі. Приклад плагіна на Lua.",
  "author": "Aurora",
  "license": "MIT",
  "language": "lua",
  "tags": ["example", "lua", "monitoring"],
  "runtime": {
    "command": "lua",
    "args": ["pulse.lua"]
  },
  "events": ["core.start", "core.stop", "session.started", "session.ended", "message.new", "settings.changed"],
  "commands": [
    {
      "name": "pulse",
      "usage": "pulse",
      "description": "Показує лічильники плагіна",
      "aliases": ["пульс"],
      "in_chat": true
    }
  ],
  "settings": [
    {
      "key": "notify_on_start",
      "type": "bool",
      "title": "Сповіщати про запуск",
      "description": "Показувати тост у панелі, коли моніторинг увімкнено",
      "default": true
    }
  ],
  "permissions": {
    "tg": ["send"]
  },
  "limits": {
    "memory_mb": 64,
    "idle_timeout_sec": 1800
  }
}
