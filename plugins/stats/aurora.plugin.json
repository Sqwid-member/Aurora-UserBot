{
  "name": "stats",
  "version": "1.0.0",
  "description": "Статус і статистика юзербота: аптайм, сесія, лічильники повідомлень і команд.",
  "author": "Aurora",
  "license": "MIT",
  "language": "python",
  "tags": ["stats", "status", "monitoring"],
  "runtime": {
    "command": "python3",
    "args": ["stats.py"]
  },
  "events": ["core.start", "session.started", "session.ended", "message.new", "command.received", "settings.changed"],
  "commands": [
    {
      "name": "stats",
      "usage": "stats",
      "description": "Показати статус і статистику юзербота",
      "aliases": ["статус", "status"],
      "in_chat": true
    }
  ],
  "settings": [
    {
      "key": "title",
      "type": "text",
      "title": "Заголовок",
      "description": "Перший рядок звіту команди stats",
      "default": "Статус Aurora"
    },
    {
      "key": "show_today",
      "type": "bool",
      "title": "Показувати «сьогодні»",
      "description": "Окремий рядок лічильників за поточну добу",
      "default": true
    }
  ],
  "permissions": {},
  "limits": {
    "memory_mb": 64
  }
}
