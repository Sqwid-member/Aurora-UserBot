{
  "name": "autoaway",
  "version": "1.0.0",
  "description": "Автоматично встановлює «Незаймай» після N хвилин тиші. Приклад плагіна на Node.js.",
  "author": "Aurora",
  "license": "MIT",
  "language": "node",
  "tags": ["example", "node", "automation"],
  "runtime": {
    "command": "node",
    "args": ["autoaway.mjs"]
  },
  "events": ["core.start", "message.new", "message.edited", "settings.changed"],
  "commands": [
    {
      "name": "away",
      "usage": "away [хвилин]",
      "description": "Увімкнути або вимкнути авто-статус",
      "aliases": ["авто"],
      "in_chat": true
    }
  ],
  "settings": [
    {
      "key": "enabled",
      "type": "bool",
      "title": "Увімкнено",
      "description": "Автоматично ставити «Незаймай» після тиші",
      "default": true
    },
    {
      "key": "minutes",
      "type": "number",
      "title": "Хвилин тиші",
      "description": "Через скільки хвилин без активності спрацьовує",
      "default": 15,
      "min": 1,
      "max": 480
    }
  ],
  "permissions": {
    "tg": ["send", "resolve"]
  },
  "limits": {
    "memory_mb": 384
  }
}
